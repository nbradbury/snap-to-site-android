{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "type" : "object",
  "properties" : {
    "about" : {
      "type" : "object",
      "properties" : {
        "photo" : {
          "type" : [ "integer", "null" ]
        },
        "text" : {
          "type" : "string",
          "description" : "A short intro paragraph under the headline: where the business is and what makes it worth a visit"
        }
      },
      "required" : [ "photo", "text" ],
      "additionalProperties" : false
    },
    "accentColor" : {
      "type" : "string",
      "description" : "Hex color like #2a6f4e suiting the business, used when there's no logo or storefront photo"
    },
    "banner" : {
      "type" : [ "string", "null" ],
      "description" : "Short announcement shown at the top of every page, e.g. a holiday closure"
    },
    "businessName" : {
      "type" : "string"
    },
    "contact" : {
      "type" : "object",
      "properties" : {
        "address" : {
          "type" : [ "string", "null" ]
        },
        "email" : {
          "type" : [ "string", "null" ]
        },
        "phone" : {
          "type" : [ "string", "null" ]
        }
      },
      "required" : [ "address", "email", "phone" ],
      "additionalProperties" : false
    },
    "events" : {
      "type" : "array",
      "items" : {
        "type" : "object",
        "properties" : {
          "date" : {
            "type" : "string",
            "description" : "Date in YYYY-MM-DD form"
          },
          "description" : {
            "type" : [ "string", "null" ]
          },
          "photo" : {
            "type" : [ "integer", "null" ]
          },
          "time" : {
            "type" : [ "string", "null" ],
            "description" : "e.g. 6 – 8pm"
          },
          "title" : {
            "type" : "string"
          }
        },
        "required" : [ "date", "description", "photo", "time", "title" ],
        "additionalProperties" : false
      }
    },
    "hero" : {
      "type" : "object",
      "properties" : {
        "heading" : {
          "type" : "string",
          "description" : "Short headline for the home page saying what the business is known for, e.g. Espresso, morning pastries & soup at lunch."
        },
        "photo" : {
          "type" : [ "integer", "null" ],
          "description" : "Index of the best wide photo for the top of the home page, usually the storefront"
        }
      },
      "required" : [ "heading", "photo" ],
      "additionalProperties" : false
    },
    "hours" : {
      "description" : "Regular opening hours in week order, plus dated exceptions such as holiday closures; empty if unknown",
      "type" : "array",
      "items" : {
        "type" : "object",
        "properties" : {
          "day" : {
            "type" : "string",
            "description" : "A weekday name or range like Tuesday – Sunday, or a specific date like Thursday, Nov 26"
          },
          "exception" : {
            "type" : "boolean",
            "description" : "True for a one-off date that overrides the regular hours"
          },
          "hours" : {
            "type" : "string",
            "description" : "e.g. 7am – 3pm, or Closed, or Closed · Thanksgiving"
          }
        },
        "required" : [ "day", "exception", "hours" ],
        "additionalProperties" : false
      }
    },
    "logoPhoto" : {
      "type" : [ "integer", "null" ],
      "description" : "Index of the photo showing the business's logo, if any"
    },
    "menu" : {
      "description" : "Menu or price list; empty if the business doesn't have one",
      "type" : "array",
      "items" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "type" : "object",
              "properties" : {
                "description" : {
                  "type" : [ "string", "null" ]
                },
                "name" : {
                  "type" : "string"
                },
                "price" : {
                  "type" : [ "string", "null" ],
                  "description" : "Price exactly as shown, e.g. $4.50"
                }
              },
              "required" : [ "description", "name", "price" ],
              "additionalProperties" : false
            }
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "items", "name" ],
        "additionalProperties" : false
      }
    },
    "special" : {
      "type" : [ "object", "null" ],
      "properties" : {
        "label" : {
          "type" : "string",
          "description" : "e.g. Today's soup"
        },
        "text" : {
          "type" : "string",
          "description" : "e.g. Tomato basil, or Ask at the counter"
        }
      },
      "required" : [ "label", "text" ],
      "additionalProperties" : false,
      "description" : "A daily special or similar changing item, if the owner mentions one"
    },
    "tagline" : {
      "type" : "string",
      "description" : "One short line under the business name"
    }
  },
  "required" : [ "about", "accentColor", "banner", "businessName", "contact", "events", "hero", "hours", "logoPhoto", "menu", "special", "tagline" ],
  "additionalProperties" : false
}
